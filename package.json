{
  "name": "oscal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "export:logo": "node scripts/export-logo.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "catalog:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-catalog.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "ops": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/operations.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-database.mjs",
    "test:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-postgres.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@vercel/functions": "3.10.1",
    "maplibre-gl": "^6.13.0",
    "nodemailer": "^10.1.2",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
