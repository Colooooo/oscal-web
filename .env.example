# Server only. Never prefix credentials with VITE_.
# Neon / PostgreSQL. Empty DATABASE_URL uses local SQLite.
DATABASE_URL=
# Direct connection for migrations and backups (no -pooler in hostname).
DATABASE_URL_UNPOOLED=
MERCADOPAGO_ACCESS_TOKEN=
PUBLIC_URL=http://localhost:5173
# Vercel Production: PUBLIC_URL=https://oscal-pink.vercel.app
# Configure DATABASE_URL there using the production branch, not the local development branch.
PORT=3001
# Keep false until real catalog, inventory and payment sandbox validation are complete.
PAYMENTS_ENABLED=false

# Exact IPs of trusted reverse proxies. Edge must OVERWRITE X-Real-IP.
# Leave empty when connecting directly. Never accept forwarded headers from arbitrary peers.
TRUSTED_PROXIES=
MERCADOPAGO_WEBHOOK_SECRET=
# test or production; verified payment.live_mode must match.
MERCADOPAGO_MODE=test
# Transactional mail. Verification/recovery stay unavailable until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
